# ============================================================
# Biography Platform - 环境变量配置
# 使用方法：复制本文件为 .env，填入真实值
#   cp .env.example .env
# ============================================================

# ── 数据库 ──
MYSQL_ROOT_PASSWORD=bio_password_2024

# ── Redis ──
REDIS_PASSWORD=bio_redis_2024

# ── RabbitMQ ──
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── MinIO ──
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── JWT 密钥（生产环境请务必修改为随机长字符串）──
JWT_SECRET=BioSecretKey_ChangeMe_InProduction_Use_A_Random_256bit_String

# ── 邮件（QQ邮箱）──
MAIL_HOST=smtp.qq.com
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_qq_smtp_authorization_code
MAIL_FROM=your_email@qq.com
